menu "Debug Configuration"

config DEBUG_ENABLE
    bool "Enable debug output"
    default y
    help
      启用调试输出到 UART。

config DEBUG_LEVEL
    int "Debug level"
    depends on DEBUG_ENABLE
    default 2
    range 0 3
    help
      调试级别：
      0 = 无输出
      1 = 错误
      2 = 警告
      3 = 信息

config DEBUG_STACK_CHECK
    bool "Enable stack overflow check"
    default y
    help
      启用栈溢出检测。
      在任务栈底填充魔数，检测栈溢出。

config ASSERT_ENABLE
    bool "Enable assertions"
    default y
    help
      启用断言检查。

endmenu

#=============================================================================
# 测试配置
#=============================================================================

menu "Test Configuration"

config TEST_ENABLE
    bool "Enable test framework"
    default y
    help
      启用测试框架。

config TEST_MODULE_SCHEDULER
    bool "Scheduler tests"
    depends on TEST_ENABLE
    default y
    help
      启用调度器测试模块。

config TEST_MODULE_EXAMPLE
    bool "Example tests"
    depends on TEST_ENABLE
    default n
    help
      启用示例测试模块。

config TEST_MODULE_TIMER
    bool "Timer tests"
    depends on TEST_ENABLE && TIMER_ENABLE
    default y
    help
      启用定时器测试模块。

config TEST_MODULE_DEADLOCK
    bool "Deadlock detection tests"
    depends on TEST_ENABLE && MUTEX_DEADLOCK_DETECT
    default y
    help
      启用死锁检测测试模块。

config TEST_MODULE_MPU
    bool "MPU protection tests"
    depends on TEST_ENABLE && MPU_ENABLE
    default y
    help
      启用 MPU 内存保护测试模块。
      (栈溢出检测、代码段保护、数据段隔离)

config TEST_MODULE_SYSCALL
    bool "Syscall interface tests"
    depends on TEST_ENABLE && SYSCALL_ENABLE
    default y
    help
      启用系统调用接口测试模块。
      (syscall 正确性、参数传递、上下文保存/恢复)

config TEST_MODULE_IRQ
    bool "Interrupt management tests"
    depends on TEST_ENABLE && IRQ_ENABLE
    default y
    help
      启用中断管理测试模块。
      (池管理、上下文检测、API 正确性)

config TEST_MODULE_CAP
    bool "Capability system tests"
    depends on TEST_ENABLE && CAP_ENABLE
    default y
    help
      启用能力系统测试模块。
      (能力生命周期、权限校验、transfer/derive)

config TEST_MODULE_FAULT
    bool "Fault handler tests"
    depends on TEST_ENABLE && FAULT_ENABLE
    default y
    help
      启用 Fault handler 测试模块。
      (crash_dump 结构、向量表验证)

config TEST_MODULE_VFS
    bool "VFS tests"
    depends on TEST_ENABLE && VFS_ENABLE
    default y
    help
      启用 VFS 虚拟文件系统测试模块。
      (inode 生命周期、fd 操作、devfs、ramfs、路径解析)

config TEST_MODULE_IPC_UPGRADE
    bool "IPC upgrade tests"
    depends on TEST_ENABLE && IPC_ENDPOINT && IPC_CHANNEL
    default y
    help
      启用 IPC 升级测试模块。
      (Endpoint C/S、Channel P2P、syscall 补全)

config TEST_MODULE_WATCHDOG
    bool "Watchdog tests"
    depends on TEST_ENABLE && KERNEL_WATCHDOG
    default y
    help
      启用看门狗测试模块。
      (IWDG 寄存器访问、喂狗、SR 状态)

config TEST_MODULE_STATS
    bool "CPU statistics tests"
    depends on TEST_ENABLE && KERN_TASK_STATS
    default y
    help
      启用 CPU 使用率统计测试模块。
      (基本功能、多任务竞争、idle 合理性)

config TEST_MODULE_BLOCK
    bool "Block device (flash) tests"
    depends on TEST_ENABLE && BLOCK_DEVICE
    default y
    help
      Phase 3 §3.3 板载 QSPI NOR flash block device 测试。
      擦写 100 sector 读回校验 + 边界检查。
      ⚠️ 会擦写 flash FS 区(固件区不动),测试期间系统卡顿几秒。

config TEST_MODULE_NOTIFICATION
    bool "Notification (event) object tests"
    depends on TEST_ENABLE && IPC_EVENT
    default y
    help
      Notification 测试:event NOWAIT poll 语义、event_set ISR 安全性、
      irq_bind_event 绑定生命周期。

config TEST_MODULE_MMIO
    bool "MMIO mapping tests"
    depends on TEST_ENABLE && MPU_ENABLE && CAP_ENABLE
    default y
    help
      核心补齐 #2:MMIO cap→MPU 映射测试(region 编程、unmap 清除、
      权限/坏 cap 拒绝)。

endmenu

