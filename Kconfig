menu "Timer Configuration"

config TIMER_ENABLE
    bool "Enable software timer"
    default y
    help
      启用软件定时器支持。

config TIMER_MAX
    int "Maximum timers"
    depends on TIMER_ENABLE
    default 16
    range 4 64
    help
      最大定时器数量。

config TIMER_CMD_QUEUE_SIZE
    int "Timer command queue size"
    depends on TIMER_ENABLE
    default 8
    range 4 32
    help
      定时器命令队列大小。

config TIMER_TASK_PRIORITY
    int "Timer service task priority"
    depends on TIMER_ENABLE
    default 1
    range 0 31
    help
      定时器服务任务优先级。
      数值越小优先级越高。
      建议设为较高优先级以确保定时器响应及时。

config TIMER_TASK_STACK_SIZE
    int "Timer service task stack size (bytes)"
    depends on TIMER_ENABLE
    default 512
    range 256 2048
    help
      定时器服务任务栈大小（字节）。

config TIMER_NAME_LEN
    int "Timer name length"
    depends on TIMER_ENABLE
    default 16
    range 8 32
    help
      定时器名称最大长度。

endmenu

menu "VFS Configuration"

config VFS_ENABLE
    bool "Enable Virtual File System"
    default y
    help
      启用 VFS 虚拟文件系统。
      提供 inode、文件描述符、路径解析，
      以及 devfs (设备文件系统) 和 ramfs (内存文件系统)。

config VFS_MAX_INODES
    int "Maximum inodes"
    depends on VFS_ENABLE
    default 32
    range 8 128
    help
      全局 inode 池大小。
      每个文件、目录、设备节点占用一个 inode。

config VFS_MAX_FDS
    int "Maximum file descriptors per task"
    depends on VFS_ENABLE
    default 8
    range 4 32
    help
      每个任务可同时打开的最大文件描述符数量。
      每 fd 占 12 字节 (inode* + flags + offset + in_use)。

endmenu

menu "Microkernel Configuration"

config MPU_ENABLE
    bool "Enable MPU memory protection"
    default y
    help
      启用 Cortex-M7 MPU 内存保护。
      用户任务运行在非特权模式，MPU region 隔离内存访问。
      这是微内核安全隔离的基础。

config SYSCALL_ENABLE
    bool "Enable syscall interface"
    depends on MPU_ENABLE
    default y
    help
      启用系统调用接口 (SVC #1)。
      用户任务通过 svc 指令请求内核服务。

config SYSCALL_TABLE_SIZE
    int "Syscall table size"
    depends on SYSCALL_ENABLE
    default 73
    range 16 96
    help
      系统调用分发表大小。必须 ≥ 最高 syscall 编号 + 1
      (当前 SYSCALL_TASK_RESTART=72，所以 default=73)。

config MPU_REGION_COUNT
    int "MPU regions per task"
    depends on MPU_ENABLE
    default 5
    range 3 8
    help
      每个用户任务使用的 MPU region 数量。
      典型: 0=代码, 1=数据, 2=栈, 3-4=共享/外设。

endmenu

menu "Interrupt Configuration"

config IRQ_ENABLE
    bool "Enable interrupt management"
    default y
    help
      启用 ISR 注册、底半部和线程化 IRQ 支持。

config IRQ_MAX_USER
    int "Maximum registered ISRs"
    depends on IRQ_ENABLE
    default 16
    range 1 64
    help
      最大可注册的用户中断处理函数数量。

config IRQ_DEFAULT_PRIORITY
    int "Default ISR priority"
    depends on IRQ_ENABLE
    default 8
    range 0 14
    help
      新注册 ISR 的默认 NVIC 优先级。
      0=最高优先级, 14=最低 (PendSV/SysTick 使用 15)。

config IRQ_BH_ENABLE
    bool "Enable bottom halves"
    depends on IRQ_ENABLE
    default y
    help
      启用底半部 (bottom half) 延迟处理机制。
      可从 ISR 中安全调度，在任务上下文中执行。

config IRQ_BH_MAX
    int "Maximum bottom halves"
    depends on IRQ_BH_ENABLE
    default 8
    range 1 32
    help
      最大底半部槽位数。

config IRQ_THREADED_ENABLE
    bool "Enable threaded IRQs"
    depends on IRQ_ENABLE
    default y
    help
      启用线程化中断处理。
      ISR 被降级为任务上下文执行，适合复杂处理。

config IRQ_THREADED_MAX
    int "Maximum threaded IRQs"
    depends on IRQ_THREADED_ENABLE
    default 4
    range 1 16
    help
      最大线程化 IRQ 槽位数。

config IRQ_THREADED_STACK_SIZE
    int "Threaded IRQ handler stack size (bytes)"
    depends on IRQ_THREADED_ENABLE
    default 512
    range 256 2048
    help
      线程化 IRQ 处理任务的栈大小。

endmenu

menu "Capability Configuration"

config CAP_ENABLE
    bool "Enable capability system"
    default y
    help
      启用能力系统 (capability-based access control)。
      所有 IPC 对象和内存分配通过能力令牌访问，
      提供权限控制和任务间隔离。

config CAP_MAX_COUNT
    int "Maximum capability entries"
    depends on CAP_ENABLE
    default 32
    range 8 128
    help
      全局能力池大小。每个 IPC 对象和内存
      分配占用一个能力槽位。

config KERN_TASK_CAP_SLOTS
    int "Capability slots per task"
    depends on CAP_ENABLE
    default 32
    range 8 64
    help
      每个任务 TCB 内的 capability slot 数量。
      必须与 tcb_t.cap_set[] 的静态大小保持一致。

endmenu

menu "Fault Handler Configuration"

config FAULT_ENABLE
    bool "Enable fault handlers"
    default y
    help
      启用完整的 Fault 异常处理。
      MemManage/BusFault/UsageFault → 终止用户任务。
      HardFault → crash dump + panic。

config FAULT_CRASH_DUMP
    bool "Enable crash dump on fault"
    depends on FAULT_ENABLE
    default y
    help
      故障时保存完整寄存器上下文到 SRAM 中的
      .crash_dump section，重启后保留用于调试。

endmenu

menu "Shell Configuration"

config SHELL_ENABLE
    bool "Enable interactive shell"
    default y
    depends on VFS_ENABLE
    help
      通过串口终端提供交互式 shell。
      测试完成后自动启动。

config SHELL_STACK_SIZE
    int "Shell task stack size (bytes)"
    depends on SHELL_ENABLE
    default 2048
    range 1024 8192
    help
      Shell 任务栈大小（字节）。
      行缓冲 + 命令解析 + 目录遍历需要较大栈空间。

config SHELL_PRIORITY
    int "Shell task priority"
    depends on SHELL_ENABLE
    default 5
    range 0 31
    help
      Shell 任务优先级（数值越小优先级越高）。

endmenu

menu "Driver Configuration"

config DRIVER_ENABLE
    bool "Enable device driver framework"
    default y
    depends on VFS_ENABLE
    help
      启用设备驱动框架。
      提供 device_t 抽象层, 驱动自动注册到 devfs。

config DRIVER_MAX_DEVICES
    int "Maximum devices"
    depends on DRIVER_ENABLE
    default 8
    range 4 16
    help
      设备注册表最大设备数。

endmenu

#=============================================================================
# Phase 2-9 Roadmap Subsystems
#
# 这些子系统代码尚未实现,CONFIG_* 在此作为 placeholder,默认全部关闭。
# 代码落地后,对应 CONFIG_* 的 default 改为 y(default/full defconfig 启用)。
# 详见 MICROKERNEL_OS_ROADMAP.md。
#=============================================================================

menu "Phase 2 — Fault-Tolerant Infrastructure"

config FAULT_ENDPOINT
    bool "Fault reporting endpoint"
    default n
    depends on FAULT_ENABLE && IPC_ENDPOINT
    help
      内核保留 endpoint,用户任务 crash 时把 fault_info 打包发送。
      Supervisor 通过 sys_fault_subscribe() 订阅。
      实现:Phase 2.1。

config SUPERVISOR
    bool "User-mode supervisor task"
    default n
    depends on FAULT_ENDPOINT
    help
      监控任务,接收 fault_info,按策略重启或 kill 故障任务。
      Rate limit: 每服务每 5s 最多 1 次重启,3 次后永久 kill。
      实现:Phase 2.2。

config INIT_PROCESS
    bool "User-mode init task"
    default n
    depends on SUPERVISOR
    help
      bootstrap 后第一个用户任务,负责启动 supervisor/driver servers/shell。
      实现:Phase 2.3。

config CAP_RESTART_SUBSET
    bool "Capability subset on restart (drop CAP_GRANT)"
    default n
    depends on SUPERVISOR && CAP_ENABLE
    help
      重启的任务不再继承 CAP_GRANT,防止失控子任务派生 cap。
      实现:Phase 2.4。

endmenu

menu "Phase 3 — Driver Servers"

config DRIVER_GPIO_SERVER
    bool "GPIO server (user-mode)"
    default n
    depends on DRIVER_ENABLE
    help
      GPIO pin 操作经 cap + endpoint 暴露给用户任务。
      实现:Phase 3.1。

config DRIVER_I2C_SERVER
    bool "I2C server (user-mode)"
    default n
    depends on DRIVER_ENABLE
    help
      I2C bus 操作经 cap + endpoint 暴露。
      实现:Phase 3.2。

config DRIVER_SPI
    bool "SPI bus driver"
    default n
    depends on DRIVER_ENABLE
    help
      SPI 控制器驱动 (RP2350 PIO / hardware SPI)。
      实现:Phase 3.3。

config BLOCK_DEVICE
    bool "Block device abstraction"
    default n
    depends on DRIVER_ENABLE
    help
      块设备 API (read/write/erase sector)。前置:CONFIG_DRIVER_SPI。
      实现:Phase 3.3。

config DRIVER_RTC
    bool "RTC + wall clock driver"
    default n
    depends on DRIVER_ENABLE
    help
      RP2350 RTC 驱动 + 用户态 timer server 代理。
      实现:Phase 3.4。

endmenu

menu "Phase 4 — Persistent Filesystem"

config FS_PERSISTENT
    bool "Persistent filesystem (littlefs)"
    default n
    depends on VFS_ENABLE && BLOCK_DEVICE
    help
      引入 littlefs (Apache 2.0),挂载到 /flash。
      Power-cut safe + wear-leveling 内建。
      实现:Phase 4.2。

config FS_LITTLEFS
    bool "Build littlefs third-party library"
    default n
    depends on FS_PERSISTENT
    help
      把 third_party/littlefs/ 编为 static library。
      关闭则 FS_PERSISTENT 无效。

endmenu

menu "Phase 5 — Application Runtime"

config USER_LIBC
    bool "User-mode libc (printf/malloc/string)"
    default n
    help
      port mini-libc (Public Domain) 为 userlibc.a。
      用户应用 -luserlc 链接。
      实现:Phase 5.1。

config ELF_LOADER
    bool "ELF loader (sys_proc_exec)"
    default n
    depends on USER_LIBC && FS_PERSISTENT
    help
      从 /flash/apps/<name>.elf 加载 ELF,解析 PT_LOAD + relocations。
      RP2350 NS 约束:同物理地址空间,MPU 隔代码/数据区。
      不支持 fork、ASLR、动态链接(动态链接留 CONFIG_DYNAMIC_LINKING)。
      实现:Phase 5.2。

endmenu

menu "Phase 6 — SMP (Cortex-M33 Core 1)"

config SMP
    bool "Symmetric multiprocessing (Core 0 + Core 1)"
    default n
    help
      启用 RP2350 第二个 Cortex-M33 核。触发 scheduler / IPC / cap / mpu
      彻底重写为 per-CPU 架构。详见 MICROKERNEL_OS_ROADMAP.md §6。
      实现:Phase 6 (4 周,5 个子切片)。

config SMP_MAX_CPUS
    int "Maximum CPU count"
    default 2
    depends on SMP
    range 2 2
    help
      RP2350 只有 2 个 Cortex-M33,固定为 2。

config SMP_WORK_STEALING
    bool "Idle CPU steals work from busy CPU"
    default y
    depends on SMP
    help
      idle CPU 从其他 CPU 的 run queue 末尾偷任务。
      关闭则任务严格按 affinity 跑。

config CAP_RCU
    bool "Capability table RCU reader"
    default n
    depends on SMP && CAP_ENABLE
    help
      跨核 cap 访问的 read-copy-update 同步。
      关闭则退化为全局 spinlock (性能差但简单)。

endmenu

menu "Phase 7 — Networking"

config DRIVER_CYW43
    bool "CYW43 WiFi bus driver"
    default n
    depends on DRIVER_ENABLE
    help
      RP2350 onboard CYW43 WiFi。Firmware 从 /flash/cyw43_fw.bin 加载。
      实现:Phase 7.1。

config NET
    bool "Network stack (lwIP + socket syscalls)"
    default n
    depends on DRIVER_CYW43
    help
      port lwIP (BSD),syscall-based socket API。
      实现:Phase 7.2。

config NET_DHCP
    bool "DHCP client"
    default y
    depends on NET

config NET_DNS
    bool "DNS resolver"
    default y
    depends on NET

config MBEDTLS
    bool "mbedTLS for HTTPS"
    default n
    depends on NET
    help
      TLS 支持。默认关,资源占用大。

endmenu

menu "Phase 8 — Security & Reliability"

config SECURE_BOOT
    bool "Signed boot image (Ed25519)"
    default n
    help
      签名 boot2 + 应用镜像,启动时验签。
      实现:Phase 8.1。

config PANIC_LOG
    bool "Panic dump to /flash/panic.log"
    default n
    depends on FS_PERSISTENT
    help
      panic 时把 backtrace 写到 flash 最后一个 sector。
      上电时 supervisor 检查并上报。实现:Phase 8.2。

config PROFILER
    bool "PC sampler + flamegraph export"
    default n
    depends on KERN_TASK_STATS
    help
      SysTick hook 采样 PC,导出 flamegraph 兼容格式。
      实现:Phase 8.3。

config OTA
    bool "Over-the-air update (A/B partition)"
    default n
    depends on FS_PERSISTENT && SECURE_BOOT
    help
      双 bank 镜像切换 + 签名校验 + 回滚。
      实现:Phase 8.4。

endmenu

menu "Phase 9 — Comprehensiveness"

config PM
    bool "Power management (sleep/deep-sleep/wakeup)"
    default n
    help
      WFI / SLEEP / DEEP-SLEEP 状态机 + wakeup source + 驱动 suspend/resume hook。
      实现:Phase 9.1。

config RT_SCHED
    bool "Real-time scheduling classes (FIFO/RR)"
    default n
    help
      SCHED_NORMAL / SCHED_FIFO / SCHED_RR。
      RT 任务优先级永远高于 normal。实现:Phase 9.2。

config DYNAMIC_LINKING
    bool "Dynamic linking (.so + dlopen)"
    default n
    depends on ELF_LOADER
    help
      PLT/GOT + sys_dlopen/sys_dlsym。资源占用大,默认关。
      实现:Phase 9.3。

config FV
    bool "Formal verification runtime hooks"
    default n
    help
      运行时不变量检查 (~5% 性能损失)。非真形式化验证。
      实现:Phase 9.4。

config FB
    bool "Framebuffer / GUI subsystem"
    default n
    depends on DRIVER_SPI || DRIVER_I2C_SERVER
    help
      仅当接 display 硬件 (SSD1306 / ILI9341) 时启用。
      实现:Phase 9.5。

endmenu
