#
# My-RTOS Configuration
# Default configuration for RP2350 (Pico 2)
#

PROJECT_NAME="my-rtos"
PROJECT_VERSION="1.0.0"

# Board selection
CONFIG_BOARD_RP2350=y
BOARD_NAME="rp2350"

# Kernel
KERNEL_TICK_RATE=1000
KERNEL_MAX_TASKS=16
KERNEL_MAX_PRIORITIES=32
KERNEL_TASK_STACK_SIZE=1024
KERNEL_IDLE_STACK_SIZE=256
KERNEL_TIME_SLICE=5
KERNEL_WATCHDOG=n
KERNEL_IDLE_SLEEP=y

# Memory
MEM_DYNAMIC=y
MEM_HEAP_SIZE=4096
MEM_POOL_COUNT=4

# IPC
IPC_SEMAPHORE=y
IPC_SEMAPHORE_MAX=8
IPC_MUTEX=y
IPC_MUTEX_MAX=8
IPC_MQUEUE=y
IPC_MQUEUE_MAX=4
IPC_EVENT=y
IPC_EVENT_MAX=4

# Debug
DEBUG_ENABLE=y
DEBUG_LEVEL=2
DEBUG_STACK_CHECK=y
ASSERT_ENABLE=y

# Test
TEST_ENABLE=y
TEST_MODULE_SCHEDULER=y
TEST_MODULE_EXAMPLE=n
