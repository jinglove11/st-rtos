#
# My-RTOS Configuration — DEFAULT preset
#
# Goal: balanced config for day-to-day development. Mirrors the working baseline
# that achieved 2867/2867 tests PASS on RP2350 (Cortex-M33, Pico SDK).
#
# Use cases:
#   - General development
#   - Running the full test suite on hardware
#   - Demo / exploratory work
#
# Apply with:
#   cp configs/default_defconfig .config
#   python3 scripts/menuconfig.py genconfig
#   cmake --build build/rp2350-pico-sdk
#
# Expected footprint: ~120-180KB flash, ~32-48KB RAM (incl. test framework)
# This is functionally identical to configs/rp2350_defconfig.
# ============================================================================

PROJECT_NAME="my-rtos"
PROJECT_VERSION="1.0.0"

# ---- Board ----
CONFIG_BOARD_RP2350=y
BOARD_NAME="rp2350"
BOARD_DISPLAY_NAME="Raspberry Pi Pico 2 W"

# ---- Kernel ----
KERNEL_TICK_RATE=1000
KERN_NAME="My-RTOS"
KERN_VERSION_MAJOR=1
KERN_VERSION_MINOR=0
KERN_VERSION_PATCH=0
KERN_TASK_NAME_LEN=16
KERNEL_MAX_TASKS=24
KERNEL_MAX_PRIORITIES=32
KERNEL_TASK_STACK_SIZE=1024
KERNEL_IDLE_STACK_SIZE=256
KERNEL_IDLE_PRIORITY=31
KERN_DEFAULT_TIME_SLICE=5
KERN_TASK_STATS=y
TRACE_ENABLE=y
TRACE_BUFFER_SIZE=256
# KERNEL_WATCHDOG is not set
KERNEL_IDLE_SLEEP=y

# ---- Memory ----
MEM_DYNAMIC=y
MEM_HEAP_SIZE=4096
MEM_POOL_COUNT=4

# ---- IPC (full) ----
IPC_SEMAPHORE=y
IPC_SEMAPHORE_MAX=8
IPC_MUTEX=y
IPC_MUTEX_MAX=8
MUTEX_DEADLOCK_DETECT=y
IPC_MQUEUE=y
IPC_MQUEUE_MAX=4
IPC_EVENT=y
IPC_EVENT_MAX=4
IPC_ENDPOINT=y
IPC_ENDPOINT_MAX=8
IPC_EP_MSG_SIZE=64
IPC_EP_MAX_PENDING=4
IPC_CHANNEL=y
IPC_CHANNEL_MAX=4
IPC_CH_MSG_SIZE=64

# ---- Timer ----
TIMER_ENABLE=y
TIMER_MAX=16
TIMER_CMD_QUEUE_SIZE=8
TIMER_TASK_PRIORITY=1
TIMER_TASK_STACK_SIZE=512
TIMER_NAME_LEN=16

# ---- VFS ----
# VFS_ENABLE is not set
VFS_MAX_INODES=32
VFS_MAX_FDS=8

# ---- Microkernel ----
MPU_ENABLE=y
SYSCALL_ENABLE=y
SYSCALL_TABLE_SIZE=96
MPU_REGION_COUNT=8

# ---- Interrupt ----
IRQ_ENABLE=y
IRQ_MAX_USER=16
IRQ_DEFAULT_PRIORITY=8
IRQ_BH_ENABLE=y
IRQ_BH_MAX=8
IRQ_THREADED_ENABLE=y
IRQ_THREADED_MAX=4
IRQ_THREADED_STACK_SIZE=512

# ---- Capability ----
CAP_ENABLE=y
CAP_MAX_COUNT=128
KERN_TASK_CAP_SLOTS=64

# ---- Fault handling ----
FAULT_ENABLE=y
FAULT_CRASH_DUMP=y

# ---- Shell ----
SHELL_ENABLE=y
SHELL_STACK_SIZE=2048
SHELL_PRIORITY=5

# ---- Driver ----
DRIVER_ENABLE=y
DRIVER_MAX_DEVICES=8

# ---- Debug ----
DEBUG_ENABLE=y
DEBUG_LEVEL=2
DEBUG_STACK_CHECK=y
ASSERT_ENABLE=y

# ---- Test (all modules on) ----
TEST_ENABLE=y
TEST_MODULE_SCHEDULER=y
TEST_MODULE_EXAMPLE=n
TEST_MODULE_FAULT=y
TEST_MODULE_CAP=y
# TEST_MODULE_VFS is not set
TEST_MODULE_IPC_UPGRADE=y
TEST_MODULE_STATS=y

# ---- Phase 2-9 subsystems (off by default; opt-in via full_defconfig) ----
# FAULT_ENDPOINT is not set
# SUPERVISOR is not set
# DRIVER_GPIO_SERVER is not set
# FS_PERSISTENT is not set
# ELF_LOADER is not set
# SMP is not set
# NET is not set
# SECURE_BOOT is not set
