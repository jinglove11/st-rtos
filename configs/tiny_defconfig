#
# My-RTOS Configuration — TINY preset
#
# Goal: smallest viable image (<32KB) for tight flash (e.g. RP2040-era 2MB QTY,
# or stripped-down RP2350 NS image). Trades observability + test hooks for size.
#
# Use cases:
#   - Size budget pressure
#   - Single-purpose firmware (one app, no shell)
#   - Quick bring-up on a new board (no test framework)
#
# Apply with:
#   cp configs/tiny_defconfig .config
#   python3 scripts/menuconfig.py genconfig
#   cmake --build build/rp2350-pico-sdk
#
# Expected footprint: ~24-32KB flash, ~4-8KB RAM
# Excluded: test framework, shell, trace, debug, dynamic heap, all Phase 2-9 subsystems
# ============================================================================

PROJECT_NAME="my-rtos"
PROJECT_VERSION="1.0.0"

# ---- Board ----
CONFIG_BOARD_RP2350=y
BOARD_NAME="rp2350"
BOARD_DISPLAY_NAME="Raspberry Pi Pico 2 W (tiny)"

# ---- Kernel (lean) ----
KERNEL_TICK_RATE=100
KERN_NAME="My-RTOS"
KERN_VERSION_MAJOR=1
KERN_VERSION_MINOR=0
KERN_VERSION_PATCH=0
KERN_TASK_NAME_LEN=8
KERNEL_MAX_TASKS=8
KERNEL_MAX_PRIORITIES=8
KERNEL_TASK_STACK_SIZE=512
KERNEL_IDLE_STACK_SIZE=128
KERNEL_IDLE_PRIORITY=7
KERN_DEFAULT_TIME_SLICE=10
# KERN_TASK_STATS is not set
# TRACE_ENABLE is not set
# KERNEL_WATCHDOG is not set
# KERNEL_IDLE_SLEEP is not set

# ---- Memory (static only) ----
# MEM_DYNAMIC is not set
MEM_POOL_COUNT=2

# ---- IPC (semaphore + mutex only — smallest set) ----
IPC_SEMAPHORE=y
IPC_SEMAPHORE_MAX=4
IPC_MUTEX=y
IPC_MUTEX_MAX=4
# MUTEX_DEADLOCK_DETECT is not set
# IPC_MQUEUE is not set
# IPC_EVENT is not set
# IPC_ENDPOINT is not set
# IPC_CHANNEL is not set

# ---- Timer (none — let app use direct SysTick if needed) ----
# TIMER_ENABLE is not set

# ---- VFS (off) ----
# VFS_ENABLE is not set

# ---- Microkernel (MPU + syscall on) ----
MPU_ENABLE=y
SYSCALL_ENABLE=y
SYSCALL_TABLE_SIZE=24
MPU_REGION_COUNT=4

# ---- Interrupt (basic) ----
IRQ_ENABLE=y
IRQ_MAX_USER=4
IRQ_DEFAULT_PRIORITY=8
# IRQ_BH_ENABLE is not set
# IRQ_THREADED_ENABLE is not set

# ---- Capability (on — microkernel essential) ----
CAP_ENABLE=y
CAP_MAX_COUNT=32
KERN_TASK_CAP_SLOTS=8

# ---- Fault (capture but no verbose dump) ----
FAULT_ENABLE=y
# FAULT_CRASH_DUMP is not set

# ---- Shell (off) ----
# SHELL_ENABLE is not set

# ---- Driver (off) ----
# DRIVER_ENABLE is not set

# ---- Debug (off) ----
# DEBUG_ENABLE is not set
# ASSERT_ENABLE is not set

# ---- Test (off) ----
# TEST_ENABLE is not set

# ---- Phase 2-9 subsystems (all off) ----
# FAULT_ENDPOINT is not set
# SUPERVISOR is not set
# DRIVER_GPIO_SERVER is not set
# FS_PERSISTENT is not set
# ELF_LOADER is not set
# SMP is not set
# NET is not set
# SECURE_BOOT is not set
