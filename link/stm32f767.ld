/**
 * @file stm32f767.ld
 * @brief STM32F767ZIT6 链接脚本
 */

/*============================================================================
 * 内存布局
 *============================================================================*/

MEMORY
{
    /* Flash: 2MB */
    FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 2M

    /* SRAM: 384KB */
    SRAM (rwx)  : ORIGIN = 0x20000000, LENGTH = 384K
}

/*============================================================================
 * 入口点
 *============================================================================*/

ENTRY(_reset_handler)

/*============================================================================
 * 段定义
 *============================================================================*/

SECTIONS
{
    /*--------------------------------------------
     * 向量表 - 必须在 Flash 起始位置
     *--------------------------------------------*/
    .isr_vector :
    {
        . = ALIGN(4);
        KEEP(*(.isr_vector))
        . = ALIGN(4);
    } > FLASH

    /*--------------------------------------------
     * 代码段
     *--------------------------------------------*/
    .text :
    {
        . = ALIGN(4);
        *(.text)
        *(.text*)
        *(.rodata)
        *(.rodata*)
        . = ALIGN(4);
        _etext = .;
    } > FLASH

    /*--------------------------------------------
     * 数据段
     *--------------------------------------------*/
    _sidata = LOADADDR(.data);

    .data :
    {
        . = ALIGN(4);
        _sdata = .;
        *(.data)
        *(.data*)
        . = ALIGN(4);
        _edata = .;
    } > SRAM AT > FLASH

    /*--------------------------------------------
     * BSS 段
     *--------------------------------------------*/
    .bss :
    {
        . = ALIGN(4);
        _sbss = .;
        *(.bss)
        *(.bss*)
        *(COMMON)
        . = ALIGN(4);
        _ebss = .;
    } > SRAM

    /*--------------------------------------------
     * 栈 (在 SRAM 末尾)
     *--------------------------------------------*/
    _estack = ORIGIN(SRAM) + LENGTH(SRAM);
}

/*============================================================================
 * 结束
 *============================================================================*/

END = .;
